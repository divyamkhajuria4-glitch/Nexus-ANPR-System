{
  "models": {
    "vehicle_weights": "models/weights/yolov8n.pt",
    "plate_weights": "models/weights/license_plate_detector.pt",
    "device": "auto"
  },
  "detection": {
    "vehicle_conf": 0.3,
    "vehicle_iou": 0.5,
    "vehicle_classes": [
      2,
      3,
      5,
      7
    ],
    "vehicle_imgsz": 640,
    "plate_conf": 0.35,
    "plate_iou": 0.45,
    "plate_imgsz": 1280,
    "plate_class_ids": null,
    "min_plate_width": 20,
    "min_plate_height": 8,
    "plate_pad_ratio": 0.2,
    "association_min_overlap": 0.65,
    "one_plate_per_vehicle_per_frame": false
  },
  "tracking": {
    "tracker_config": "bytetrack.yaml",
    "orphan_iou_threshold": 0.3,
    "orphan_max_age_frames": 15
  },
  "ocr": {
    "engines": [
      "easyocr",
      "tesseract"
    ],
    "languages": [
      "en"
    ],
    "allowlist": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
    "allow_model_download": false,
    "easyocr_model_dir": null,
    "easyocr_use_gpu": false,
    "primary_variants": [
      "color",
      "clahe"
    ],
    "fallback_variants": [
      "sharpen",
      "bilateral",
      "otsu",
      "adaptive",
      "perspective"
    ],
    "fallback_trigger_confidence": 0.6,
    "min_resize_height": 64,
    "max_resize_width": 640,
    "max_ocr_frames_per_track": 30,
    "stop_ocr_after_confirmed_frames": 10
  },
  "consensus": {
    "min_text_length": 4,
    "max_text_length": 12,
    "min_vote_confidence": 0.6,
    "min_support_frames": 1,
    "min_weight_share": 0.6,
    "min_margin_share": 0.25
  },
  "video": {
    "frame_stride": 1,
    "output_fps": null,
    "output_scale": 1.0,
    "max_frames": null,
    "max_consecutive_frame_errors": 5
  },
  "output": {
    "output_dir": "output",
    "log_dir": "logs",
    "save_crops": true,
    "save_video": true,
    "transcode_h264": true
  }
}
